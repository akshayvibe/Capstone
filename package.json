{
  "name": "helix",
  "version": "0.1.0",
  "description": "HELIX — AI-powered multi-agent software development assistant (CLI orchestrator)",
  "type": "commonjs",
  "bin": {
    "helix": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "helix": "node dist/index.js"
  },
  "keywords": ["cli", "ai", "multi-agent", "orchestrator", "commander"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
