# Copy this file to .env and fill in your real values.
# NEVER commit .env.

OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# HELIX agent/tooling settings
